.DS_Store

# workspace/ — projetos descartáveis para testar o toolkit.
# Fica no disco para você acompanhar, fora do git para não poluir o histórico.
workspace/

# .maestri/ — estado local da equipe multiagente (roles, sessões).
# Pertence à máquina, não ao toolkit.
.maestri/

# Symlinks que o dev-link criava no projeto antes de ligar a instalação de
# usuário: skills e agentes em .claude/, o espelho do Codex em .agents/skills e a
# camada omp em .omp/. O dev-link de hoje liga ~/.claude, ~/.agents/skills e
# ~/.omp/agent, e tira estes ao rodar; o ignore fica para o clone que ainda os tem.
# A anvil-sync é exceção: é do repositório e não vai no payload.
.claude/skills/*
!.claude/skills/anvil-sync/
.claude/agents/*
.agents/skills/*
.omp/
